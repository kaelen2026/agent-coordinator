# 复制为 .env 使用（.env 不入库）。值与 compose.yaml 的本地基建一致。

DATABASE_URL=postgres://postgres:postgres@localhost:5432/agent_coordinator
REDIS_URL=redis://localhost:6379

# api
PORT=3001
# production 时 BETTER_AUTH_URL / AUTH_TRUSTED_ORIGINS / AUTH_TRUSTED_PROXIES 不再有默认值，
# 缺一个就启动失败——这三个兜底成开发值的后果是发出不带 Secure 的 cookie、信任清单形同虚设、
# 限流退化成全站共享桶。
NODE_ENV=development

# 认证（apps/api）
# 会话签名密钥：本地用 `openssl rand -hex 32` 自行生成，禁止提交真实值。留空则启动即失败。
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001
# 允许携带 cookie 跨源访问 api 的前端源，逗号分隔
AUTH_TRUSTED_ORIGINS=http://localhost:3000
# web 与 api 不同站点时置 true（cookie 走 SameSite=None; Secure; Partitioned）
AUTH_COOKIE_CROSS_SITE=false
# 代理拓扑，生产环境必填（决定限流怎么分桶，漏配会让全站共用一个限流桶）：
#   none                      本服务直连暴露、前面没有代理
#   10.0.0.0/8,192.168.1.1    反向代理/LB 的 IP 或 CIDR，逗号分隔
AUTH_TRUSTED_PROXIES=none

# web（apps/web）
# 浏览器直接访问的 api 地址：会被打进客户端 bundle，只能放公开信息，禁止放任何 secret。
# 必须在 AUTH_TRUSTED_ORIGINS 的对端——即 web 从这个地址带 cookie 访问 api。
#
# ⚠️ **部署流水线必须传真实值。** 这个变量在 `next build` 时被内联进客户端 bundle，
# 而构建期**故意**允许它缺失——CI 上没有本文件，构建期若严格校验就永远绿不了
# （见 apps/web/src/lib/env.ts 里构建期/运行期的分界说明）。代价是：漏配不会让构建失败，
# 而是产出一份"能发布、但每个用户打开都是错误页"的产物——失败点从构建期挪到了用户的浏览器里。
# 所以做部署 workflow 时要么显式传值，要么自己加一道"构建产物里该变量非空"的检查。
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# 本服务自有端点（/api/me 等）的限流：每个客户端 IP、每条路径、每个窗口的额度。
# /api/auth/* 另有 better-auth 自己的限流（更严），两层都落库。
API_RATE_LIMIT_WINDOW_SECONDS=60
API_RATE_LIMIT_MAX=120
